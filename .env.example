# Copy to .env and fill in. Every value has a default; blank means "use the default".

# ============================================================ storage
# Database, working files, the inbox folder and saved logins all live under here.
DATA_DIR=./data
# DB_PATH=            # default: DATA_DIR/clip_pipeline.db
# INBOX_DIR=          # default: DATA_DIR/inbox  (drop video files here instead of giving a link)
# A file in the inbox is taken once it has not changed for this many seconds (its copy has finished)
INBOX_SETTLE_SECONDS=10
POLL_SECONDS=5
MAX_UPLOAD_GB=30
# Run below normal CPU priority so other things on the machine stay responsive
LOW_PRIORITY=true

# ============================================================ network and access
# Where the service listens. 127.0.0.1 = this machine only. To let a paired phone on the same private network
# reach it, use this machine's private address (or 0.0.0.0) and set PUBLIC_URL to what the phone should open.
BIND_HOST=127.0.0.1
PORT=8000
# PUBLIC_URL=http://192.168.1.20:8000
# Every request must be signed by a paired device (python -m clip_pipeline pair). Turn off only for development.
AUTH_REQUIRED=true

# ============================================================ tools
# Optional explicit binaries (leave blank to resolve from PATH)
FFMPEG_PATH=
YTDLP_PATH=
# Encoder: auto | nvenc | qsv | amf | vaapi | x264
# auto = the first hardware encoder that passes a test encode on this machine, else software (x264)
VIDEO_ENCODER=auto
VIDEO_BITRATE=8M
# VAAPI_DEVICE=/dev/dri/renderD128
# Font for burned-in captions and hook titles (the Docker image maps Arial to Liberation Sans)
# CAPTION_FONT=Arial

# ============================================================ finding clips
# faster-whisper (CPU int8 is the fastest path on AVX-512 CPUs)
# small is fast; large-v3-turbo is about 2.6x slower on a CPU but hears languages and words more accurately
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=12
# Blank = work out the language(s) each video is spoken in. Set e.g. tr to force one language for everything.
WHISPER_LANGUAGE=
# A language needs this share of a video's speech to be used for its captions (keeps songs from flipping them)
LANGUAGE_MIN_SHARE=0.15

# Peak detection
CANDIDATE_COUNT=25
CANDIDATE_PRE_ROLL=35
CANDIDATE_POST_ROLL=25
CHAT_LAG_SECONDS=6

# Gemini free tier (https://aistudio.google.com/apikey). Blank key => offline heuristic scoring.
# Models are tried in this order: when one runs out of free-tier quota (each has its own, see
# https://aistudio.google.com/rate-limit) the next takes over; when none is left, scoring is done offline.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite

# A scoring request with no reply after this many seconds is abandoned and tried again, then on the next model
GEMINI_TIMEOUT_SECONDS=120
# The most time one batch may spend waiting on Gemini before it is scored offline
GEMINI_BATCH_BUDGET_SECONDS=480

# Clips scoring at least this (0-100) are cut and offered for review
REVIEW_MIN_SCORE=70
SLICE_PADDING=10

# MediaPipe face detector model (downloaded automatically on first use). Default: DATA_DIR/models/…
# FACE_MODEL_PATH=

# ============================================================ publishing
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
UPLOAD_MAX_ATTEMPTS=3
UPLOAD_RETRY_BACKOFF_SECONDS=300
# Posting slots are times of day in this zone (IANA name, e.g. Europe/Istanbul). Blank = this machine's zone
TIMEZONE=
# How often to check which posted clips are due for another view-count reading (0 = never)
STATS_INTERVAL_MINUTES=30

# Logins below become an account called "default" on first start. More accounts: POST /accounts.

# YouTube Data API v3 (python -m clip_pipeline.publish.scripts.youtube_auth client_secret.json)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_CATEGORY_ID=20

# Instagram Graph API (Creator/Business account linked to a Facebook Page)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=v26.0

# TikTok: log in once with `python -m clip_pipeline.publish.uploaders.tiktok --login --state <file>` on a
# machine with a screen, then put the file at TIKTOK_STORAGE_STATE. Default: DATA_DIR/secrets/tiktok_state.json
# TIKTOK_STORAGE_STATE=
# TIKTOK_USER_DATA_DIR=
TIKTOK_HEADLESS=true
